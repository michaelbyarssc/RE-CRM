# Copy to .env.local and fill in. Names only here: never commit real values.

# Postgres connection string (the app and scripts/db-*.mjs use it)
DATABASE_URL=

# Supabase project URL and public (anon) key, used for sign-in only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The site's own address, for example https://dealdeskpro.com
NEXT_PUBLIC_APP_URL=

# Google OAuth client for Calendar sync. The secret also signs the OAuth state.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required to save third-party keys and use Google Calendar: 32 random bytes in
# base64, created with: openssl rand -base64 32
# Encrypts saved keys and Google tokens. Keep a copy in a password manager:
# losing it makes every saved key unreadable. Every environment that uses the
# same database needs the same value. To rotate, add SETTINGS_ENCRYPTION_KEY_V2.
SETTINGS_ENCRYPTION_KEY=

# Optional, at least 16 characters: lets a trusted caller run every user's
# due sequence steps (POST /api/sequences/process with "Bearer <value>").
CRON_SECRET=
