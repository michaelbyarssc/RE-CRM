# Example of the local settings file of the layout check tool.
#
# You do not copy this file by hand: "bash tests/layout-check/setup.sh" writes
# the real one (tests/layout-check/out/settings.env, mode 600, never committed)
# and makes up the two passwords and the key on your machine.
#
# Every value below is a dummy. Never put a live value in the real file: the
# tool refuses a database that is not local or whose name does not start with
# recrm_layout.
#
# Format: NAME=value, one per line, no quotes, no "export".

# The local throwaway database. The role has the same name as the database.
DATABASE_URL=postgres://recrm_layout_check:dummy-database-password@127.0.0.1:5432/recrm_layout_check

# Port of the local sign-in stub (auth-stub.mjs). The app is built to talk to
# http://127.0.0.1:<this port> in place of Supabase.
AUTH_STUB_PORT=54400

# The app encrypts saved keys with this (base64 of 32 random bytes).
SETTINGS_ENCRYPTION_KEY=dummy-base64-key-made-by-setup-sh

# The one made-up user the stub lets in. The seed gives every row to this user.
DEMO_USER_ID=00000000-0000-4000-8000-000000000000
DEMO_USER_EMAIL=owner.demo@example.com
DEMO_USER_PASSWORD=dummy-sign-in-password
